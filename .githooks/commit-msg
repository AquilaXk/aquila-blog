#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file is required}"

# Optional per-machine commit message filter (for example an editor/agent attribution
# stripper that lives outside this repository). Opt in locally so that no personal path is
# hardcoded here:
#   git config hooks.commitMsgFilter /path/to/filter.sh
# It runs before the LC_ALL pin below so the filter keeps the developer's own locale, and a
# failing filter only warns: the commit message rules stay the source of truth.
commit_msg_filter="$(git config --get hooks.commitMsgFilter || true)"
if [[ -n "${commit_msg_filter}" && -f "${commit_msg_filter}" && -x "${commit_msg_filter}" ]]; then
  if ! "${commit_msg_filter}" "$msg_file"; then
    echo "[commit-msg] hooks.commitMsgFilter 실행 실패, 무시하고 계속합니다: ${commit_msg_filter}" >&2
  fi
fi

# bash resolves regex ranges such as [가-힣] through locale collation, so the Hangul check
# below matches nothing under a UTF-8 collation. Pin LC_ALL (not only LC_COLLATE) because an
# exported LC_ALL would otherwise override the pin. Under LC_ALL=C that same range would
# instead match every non-ASCII byte, so the check matches UTF-8 byte sequences directly.
export LC_ALL=C

# Git drops blank leading lines and comment lines from the commit message, so the subject is
# the first line that is neither.
comment_char="$(git config --get core.commentChar || true)"
if [[ -z "${comment_char}" || "${comment_char}" == "auto" ]]; then
  comment_char="#"
fi

subject=""
while IFS= read -r line || [[ -n "${line}" ]]; do
  line="${line//$'\r'/}"
  blank="${line//[[:space:]]/}"
  if [[ -z "${blank}" ]]; then
    continue
  fi
  if [[ "${line:0:1}" == "${comment_char}" ]]; then
    continue
  fi
  subject="${line}"
  break
done < "$msg_file"

# Allow Git auto-generated/system commit titles.
autogenerated_re='^(Merge|Revert|fixup!|squash!|amend!) '
if [[ "$subject" =~ $autogenerated_re ]]; then
  exit 0
fi

# Recommended practical format (Conventional Commit + ko/en mixed summary):
# - <type>(<scope>): <summary>
# - type/scope are english, summary includes both Korean and English.
#
# Example:
#   feat(auth): 로그인 세션 안정화 (refresh token rotation)
#   fix(feed): 좋아요 optimistic update race condition 수정
if ! [[ "$subject" =~ ^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)(\([a-z0-9][a-z0-9._/-]*\))?!?:\ .+$ ]]; then
  cat >&2 <<'EOF'
[commit-msg] 커밋 메시지 규칙 위반
형식: <type>(<scope>): <한글+English 혼합 요약>
예시1: feat(auth): 로그인 세션 안정화 (refresh token rotation)
예시2: fix(feed): 좋아요 optimistic update race condition 수정
허용 타입: feat, fix, refactor, chore, docs, style, test, perf, build, ci, revert, hotfix
EOF
  exit 1
fi

# Enforce mixed-language summary in practice.
summary="${subject#*: }"

# Hangul as raw UTF-8 byte sequences: syllables U+AC00-U+D7A3 plus compatibility jamo
# U+3131-U+3163, the exact set the previous [가-힣ㄱ-ㅎㅏ-ㅣ] range meant. Broader byte ranges
# would also accept unrelated scripts (Yi, Latin Extended-D). The pattern must stay in a
# variable: bash matches an inline $'...' operand of =~ literally, not as a regex.
hangul_re=$'\xEA[\xB0-\xBF][\x80-\xBF]|[\xEB\xEC][\x80-\xBF][\x80-\xBF]|\xED[\x80-\x9D][\x80-\xBF]|\xED\x9E[\x80-\xA3]|\xE3\x84[\xB1-\xBF]|\xE3\x85[\x80-\xA3]'

# 1) Summary must include at least one Hangul char.
if ! [[ "$summary" =~ $hangul_re ]]; then
  cat >&2 <<'EOF'
[commit-msg] 제목에는 한글이 최소 1자 이상 포함되어야 합니다.
예시: fix(feed): 좋아요 optimistic update race condition 수정
EOF
  exit 1
fi

# 2) Summary must include at least one English letter.
if ! [[ "$summary" =~ [A-Za-z] ]]; then
  cat >&2 <<'EOF'
[commit-msg] 제목에는 영문 키워드가 최소 1자 이상 포함되어야 합니다.
예시: feat(auth): 로그인 세션 안정화 (refresh token rotation)
EOF
  exit 1
fi
