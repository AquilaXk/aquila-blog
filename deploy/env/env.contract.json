{
  "version": 1,
  "placeholderPattern": "^(?:NEED_TO|EMPTY$|change_me|change-me|.*example\\.com$|https://www\\.example\\.com|https://api\\.example\\.com|smtp\\.example\\.com|.*<[^>]+>.*|.*sha-<[^>]+>.*)",
  "targets": {
    "home-server-source": {
      "description": "GitHub Secret HOME_SERVER_ENV before deploy-time image injection.",
      "keys": [
        {
          "name": "WEB_DOMAIN",
          "kind": "hostname",
          "required": false,
          "requiredWhen": { "key": "CUSTOM_PROD_BACKURL", "hostEquals": "blog.aquilaxk.site" },
          "rejectEmptyValue": true,
          "description": "Public web host served by the Caddy web vhost (#1538). Since #1575 it also carries the public API paths, so it is the host the auth cookie is scoped to and, since #1596, the only public front door the edge has. Optional only before the cutover: once CUSTOM_PROD_BACKURL moves to the same-origin topology, leaving this unset would 404 the public site AND the public API while the contract still passed."
        },
        {
          "name": "COMPANY_DOMAIN",
          "kind": "hostname",
          "required": false,
          "rejectEmptyValue": true,
          "allowedValues": ["www.aquilaxk.site"],
          "description": "Company surface host served by its own Caddy vhost from the same front container (#1605). It is the site canonical, and APEX_DOMAIN's redirect target is derived from this key. Optional: while unset the vhost stays on its unreachable company.localhost default, which is the shape that keeps the surface invisible until the owner opens its Tunnel hostname. An empty value means nothing here - it collapses the site address to `http://`, a host-matcher-less :80 catch-all - so it is rejected outright. Pinned to one host like API_DOMAIN, because the front does not learn this value at runtime: front/site.config.js hard-codes the surface canonical table and src/libs/publicSurfaceUrl.ts matches the request Host against it. Any other hostname would be served by Caddy while canonical/OG pointed elsewhere and the sitemap host guard rejected it - a silent metadata mismatch instead of a rejected config."
        },
        {
          "name": "PRODUCT_DOMAIN",
          "kind": "hostname",
          "required": false,
          "rejectEmptyValue": true,
          "allowedValues": ["easysubway.aquilaxk.site"],
          "description": "Product surface host served by its own Caddy vhost from the same front container (#1605). Same optional-but-never-empty rule as COMPANY_DOMAIN, and pinned to one host for the same reason: the front's surface canonical table is compiled in, not injected."
        },
        {
          "name": "APEX_DOMAIN",
          "kind": "hostname",
          "required": false,
          "rejectEmptyValue": true,
          "description": "Apex host whose vhost 308s to COMPANY_DOMAIN with path and query preserved (#1605). It serves no content of its own. Same optional-but-never-empty rule as COMPANY_DOMAIN; setting it without COMPANY_DOMAIN would redirect the apex at the unreachable company.localhost default, so the cross-check below requires the pair."
        },
        {
          "name": "WEB_UPSTREAM",
          "required": false,
          "allowedValues": ["front_blue", "front_green"],
          "description": "Active front colour the Caddy web vhost proxies to (default front_blue). Interpolated straight into the Caddyfile reverse_proxy target, so a typo would route public web traffic at whatever else Caddy can reach. The blue/green switch that writes it is #1539."
        },
        { "name": "MONITOR_DOMAIN", "kind": "hostname" },
        { "name": "GRAFANA_DOMAIN", "kind": "hostname" },
        { "name": "PROMETHEUS_DOMAIN", "kind": "hostname" },
