{
  email {$CADDY_EMAIL}
}

# Cloudflare Tunnel → Caddy trusted-edge client IP.
# Capture CF-Connecting-IP, strip client-controllable hop headers, then re-emit
# only trusted values upstream (HR-56: no silent trust-all XFF).
(trusted_edge_client_ip) {
	header_up CF-Connecting-IP {vars.trusted_client_ip}
	header_up X-Forwarded-For {vars.trusted_client_ip}
	header_up X-Real-IP {vars.trusted_client_ip}
	header_up -True-Client-IP
}

# Capture the one client IP the upstream is allowed to believe, then strip every spoofable hop
# header. `vars` is ordered before `request_header` in Caddy's directive order, which is why the
# capture can read a header the next lines delete.
#
# CF-Connecting-IP is only trustworthy where Cloudflare Tunnel is the one writing it. The API vhost
# also carries the container-internal site address `http://caddy` (#1539), which any container on
# the compose networks can reach directly; there the header is caller-controlled, so believing it
# would let an internal caller forge the client IP that lands in audit logs and rate-limit buckets.
# On that address the peer address is the only honest answer.
#
# The split lives here rather than in the API vhost so a future internal address on any other vhost
# inherits the same boundary instead of silently trusting the header.
#
# request_header supports single-line ops only (no block form; unlike `header`).
(edge_client_ip_capture) {
	@internalEntry host caddy
	@cloudflareEdge not host caddy
	vars @cloudflareEdge trusted_client_ip {http.request.header.CF-Connecting-IP}
	vars @internalEntry trusted_client_ip {remote_host}

	request_header -X-Forwarded-For
	request_header -CF-Connecting-IP
	request_header -True-Client-IP
	request_header -X-Real-IP
}

# Public API edge gates, shared by the host-based API vhost and the same-origin web vhost (#1575).
#
# The public API moved from its own host to `{$WEB_DOMAIN}` paths, so the same request now has two
# possible front doors during the transition window. Duplicating the gate list per vhost is how a
# security gate silently disappears on one door only, which is why this is one snippet imported in
# both places instead of two copies.
#
# `import` is token substitution, so the import site decides the scope. At an API vhost's top level
# the `header` block below applies to that whole vhost (its only content is the API). Inside the web
# vhost it is imported within `handle @backendApi`, so it covers backend responses only and never
# touches the Next.js responses whose headers front/next.config.js owns (HR-56).
#
# The terminal `handle` is part of the snippet: whatever the gates above did not claim is backend
# traffic in both vhosts - on the web vhost only because the import already sits inside the
# backend-prefix handle.
(backend_edge_gates) {
	# Align with Cloudflare free-plan body limit (100 MiB). Oversized bodies get 413 before Spring.
	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@notificationSse path /member/api/v1/notifications/stream
	log_skip @notificationSse

	@oauthCallbackSensitive path /login/oauth2/code/*
	log_skip @oauthCallbackSensitive

	@signupVerifySensitive path /member/api/v1/signup/email/verify
	log_skip @signupVerifySensitive

	@socialSignupSensitive path /member/api/v1/signup/social/pending /member/api/v1/signup/social/complete
	log_skip @socialSignupSensitive

	@accountDeletionSensitive path /member/api/v1/privacy/account
	log_skip @accountDeletionSensitive

	@cloudExternalContentSensitive path /system/api/v1/adm/cloud/files/*/external-content
	log_skip @cloudExternalContentSensitive

	@publicSearchSensitive path /post/api/v1/posts/search
	log_skip @publicSearchSensitive

	# Prometheus metrics are scraped via internal Docker network only.
	# Public access through any edge host is explicitly denied.
	#
	# This must be a `handle`, not a bare `respond`. Caddy's directive order puts `respond` AFTER
	# `handle`, so a top-level `respond @denyPrometheus 403` is compiled behind the catch-all
	# backend proxy and never runs - measured on the pre-#1575 config, which answered
	# `GET /actuator/prometheus` with the backend response instead of 403.
	@denyPrometheus path /actuator/prometheus
	handle @denyPrometheus {
		respond 403
	}

	handle @notificationSse {
		header {
			Cache-Control "no-cache, no-transform"
		}

		reverse_proxy {$ADMIN_API_UPSTREAM:back_blue}:8080 {
			import trusted_edge_client_ip
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -Referrer-Policy
			header_down -Permissions-Policy
			flush_interval -1
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}

	# read 런타임 분리: 공개 read API를 별도 upstream으로 점진 분리할 수 있다.
	# Paths must match PublicApiRouteContributor SoT export (tools/guards/public-api-read-caddy-paths.sot).
	@publicReadFallback {
		path /post/api/v1/files/* /post/api/v1/images/* /post/api/v1/posts /post/api/v1/posts/* /post/api/v1/posts/*/comments /post/api/v1/posts/*/comments/* /post/api/v1/posts/bootstrap /post/api/v1/posts/explore /post/api/v1/posts/explore/cursor /post/api/v1/posts/feed /post/api/v1/posts/feed/cursor /post/api/v1/posts/related/author /post/api/v1/posts/search /post/api/v1/posts/tags /system/api/v1/adm/cloud/files/*/external-content
		method GET HEAD OPTIONS
	}
	handle @publicReadFallback {
		reverse_proxy {$READ_API_UPSTREAM:back_blue}:8080 {
			import trusted_edge_client_ip
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -Referrer-Policy
			header_down -Permissions-Policy
			transport http {
				dial_timeout 3s
				response_header_timeout 12s
			}
		}
	}

	# 점진 분리: admin API는 별도 upstream으로 라우팅 가능(기본 back_blue 유지).
	@adminApi {
		path /post/api/v1/adm/* /member/api/v1/adm/* /system/api/v1/adm/*
	}
	handle @adminApi {
		reverse_proxy {$ADMIN_API_UPSTREAM:back_blue}:8080 {
			import trusted_edge_client_ip
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -Referrer-Policy
			header_down -Permissions-Policy
			transport http {
				dial_timeout 3s
				response_header_timeout 12s
			}
		}
	}

	# Blue/Green cutover rewrites single active upstream host.
	handle {
		encode gzip zstd

		reverse_proxy {$ADMIN_API_UPSTREAM:back_blue}:8080 {
			# Public traffic is HTTPS at the Cloudflare edge, but the tunnel origin to
			# Caddy is plain HTTP. Spring uses forwarded headers to compute OAuth2
			# callback URLs, so we pin the upstream scheme/host to the external URL.
			import trusted_edge_client_ip
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_down -Strict-Transport-Security
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -Referrer-Policy
			header_down -Permissions-Policy
			transport http {
				dial_timeout 3s
				response_header_timeout 12s
			}
		}
	}
}

# Uptime Kuma dashboard/status endpoint (optional).
# Set MONITOR_DOMAIN in .env.prod and Cloudflare Tunnel Public Hostname.
# ADMIN_EMBED_ORIGINS: space-separated admin UI origins allowed to iframe this host.
http://{$MONITOR_DOMAIN:status.localhost} {
  reverse_proxy uptime_kuma:3001 {
    # Allow embedding public status page in admin UI (XFO only; keep/replace CSP below).
    header_down -X-Frame-Options
  }

  header {
    # HR-56: do not strip CSP as an embed workaround. Enforce admin-origin frame-ancestors.
    -X-Frame-Options
    Content-Security-Policy "frame-ancestors {$ADMIN_EMBED_ORIGINS}"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

# Grafana dashboard endpoint (optional).
# Set GRAFANA_DOMAIN in .env.prod and Cloudflare Tunnel Public Hostname.
http://{$GRAFANA_DOMAIN:grafana.localhost} {
  forward_auth {$ADMIN_API_UPSTREAM:back_blue}:8080 {
    uri /system/api/v1/adm/grafana/auth-proxy
    copy_headers X-WEBAUTH-USER X-WEBAUTH-NAME
    header_up Host {host}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Port 443
  }

  reverse_proxy grafana:3000 {
    header_up X-WEBAUTH-USER {http.request.header.X-WEBAUTH-USER}
    header_up X-WEBAUTH-NAME {http.request.header.X-WEBAUTH-NAME}
    # Admin UI iframe embed compatibility (XFO only; keep/replace CSP below).
    header_down -X-Frame-Options
  }

  header {
    # HR-56: do not strip CSP as an embed workaround. Enforce admin-origin frame-ancestors.
    # ADMIN_EMBED_ORIGINS: space-separated admin UI origins allowed to iframe Grafana.
    -X-Frame-Options
    Content-Security-Policy "frame-ancestors {$ADMIN_EMBED_ORIGINS}"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

# Prometheus UI endpoint (optional).
# Set PROMETHEUS_DOMAIN in .env.prod and Cloudflare Tunnel Public Hostname.
http://{$PROMETHEUS_DOMAIN:prometheus.localhost} {
  basic_auth {
    {$PROMETHEUS_BASIC_AUTH_USER} {$PROMETHEUS_BASIC_AUTH_HASH}
  }

  reverse_proxy prometheus:9090

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

# Cloudflare Tunnel origin: HTTP only between cloudflared and Caddy.
#
# Backend-only vhost. Since #1575 the *public* API is same-origin under {$WEB_DOMAIN}, and #1596
# retired the pre-transition public API host, so no live public address is left here. The vhost
# stays because `http://caddy` below is permanent and because the transition-only
# `{$LEGACY_API_DOMAIN}` slot is what makes a future host-based migration possible
# (see docs/ops/homeserver-front-domain-cutover.md).
#
# Nothing in this block proxies to the front tier, which is what makes the internal entry point
# loop-free: a front server-side call to `http://caddy` can only ever land on the backend.
#
# LEGACY_API_DOMAIN is transition-only and unset outside a migration window. It exists so an old
# and a new host-based address can be live at the same time - with a single address every cutover
# order breaks one side of the switch for a while. Its `.localhost` default is required: an empty
# value collapses the address to `http://`, which Caddy adapts into a host-matcher-less :80
# catch-all. It must also differ from WEB_DOMAIN, because two site blocks sharing one address take
# the whole edge down on the next caddy recreate (the env contract enforces both).
#
# There is deliberately no CORS anywhere in this file. The public API is a path on the web host,
# so browser calls to it are same-origin and a cross-origin allowlist would only widen what this
# edge accepts. The retired API host was the last address that needed one (#1596).
#
# The other address `http://caddy` is the container-internal entry point (#1539). The front
# tier calls the backend from the server side (SSR helpers and the /api/backend/* proxy) and
# must reach the same route split the browser gets: under runtime-split, public reads belong
# to back_read and everything else to back_admin, and no single backend container serves both
# (ApiRuntimeBoundaryFilter answers 503 outside its mode). Pointing the front at one container
# would therefore break either the public feed or the auth/write paths, and pointing it at the
# active blue/green colour would break again on every colour flip. Routing it through this
# vhost keeps one source of truth for the split and needs no colour tracking.
#
# It is a literal name, not an env placeholder, so it can never collapse into the empty
# address the note above warns about. Reachability is unchanged: the only listeners are the
# compose networks caddy joins plus a 127.0.0.1-only host bind, and Cloudflare Tunnel forwards
# the original public Host, so no external request can arrive with `Host: caddy`.
http://{$LEGACY_API_DOMAIN:legacy-api.localhost}, http://caddy {
  log {
    output stdout
    format json
  }

  import edge_client_ip_capture

  # This vhost only. The web vhost must NOT get this: there front/public/robots.txt is the real
  # robots.txt and it advertises the sitemap, so a `Disallow: /` here would deindex the blog.
  # A host-based backend address has no crawlable content, so it keeps refusing crawlers even
  # while a migration window has LEGACY_API_DOMAIN publicly resolvable.
  # It shares the handle group with the imported gates below, and their matchers are disjoint.
  @apiRobots path /robots.txt
  handle @apiRobots {
    header {
      Content-Type "text/plain; charset=utf-8"
      Cache-Control "public, max-age=300"
    }
    respond "User-agent: *\nDisallow: /\n" 200
  }

  import backend_edge_gates
}

# Public web host (#1538). Value is WEB_DOMAIN=blog.aquilaxk.site (Epic #1535 Locked Decision 5).
# www.aquilaxk.site is retired without a redirect (Locked Decision 6), so this vhost carries the
# one address and no `redir` exists anywhere in this file.
#
# The .localhost default is not cosmetic: an unset WEB_DOMAIN leaves the address as bare
# `http://`, which caddy adapt turns into a route with no host matcher — a port-80 catch-all that
# answers every hostname the other vhosts do not claim (verified with `caddy adapt`). An
# unreachable localhost vhost is the fail-closed shape, matching MONITOR/GRAFANA/PROMETHEUS.
http://{$WEB_DOMAIN:web.localhost} {
  log {
    output stdout
    format json
  }

  # front API routes (rum/vitals, rum/client-errors) must see a client IP they can trust.
  import edge_client_ip_capture

  # /_next/static/* is content-hashed and immutable. Next.js already emits this exact
  # Cache-Control, so the `?` prefix asserts a floor without overwriting the app's value.
  # front/next.config.js owns the security headers; this vhost must not strip or weaken them,
  # which is why there is no site-level `header` block and no `header_down` here (HR-56).
  @nextImmutable path /_next/static/*
  header @nextImmutable {
    ?Cache-Control "public, max-age=31536000, immutable"
  }

  # Same-origin public API (#1575). The public API host was going to be api.blog.aquilaxk.site,
  # but a two-label subdomain sits outside Cloudflare Universal SSL and fails the TLS handshake
  # (alert 40, measured), so the API is served from this host by path instead.
  #
  # The prefix list is the backend's public route surface, verified against the front route table:
  # front owns `/api/*` (Next API routes) and the backend has no bare `/api` prefix, and
  # `/login` (front page) is one path segment shorter than `/login/oauth2/*` (Spring callback).
  # `/actuator/*` is narrowed to health only: the rest has no reason to be public on the web host.
  # Both the aggregate `/actuator/health` and the `/actuator/health/*` probes are listed - a path
  # matcher without the bare form would send the aggregate endpoint (documented in
  # deploy/homeserver/HARDENING.md and reachable to external monitors) to front's 404 instead.
  # `/actuator/prometheus` therefore never reaches the backend through this vhost - it falls
  # through to front and 404s. The shared gates deny it outright as well, which is what answers on
  # the host-based API vhost and what would answer here if this prefix were ever widened.
  #
  # The backend's `GET /` and `GET /session` are deliberately NOT routed here: front does not call
  # them (it uses /member/api/v1/auth/session) and `/` is the site itself.
  @backendApi path /member/* /post/* /system/* /oauth2/* /login/oauth2/* /actuator/health /actuator/health/*
  handle @backendApi {
    import backend_edge_gates
  }

  # Blue/Green cutover rewrites the single active upstream host (#1539 owns the switch).
  handle {
    encode gzip zstd

    reverse_proxy {$WEB_UPSTREAM:front_blue}:3000 {
      # Public traffic is HTTPS at the Cloudflare edge, but the tunnel origin to Caddy is
      # plain HTTP. Next.js builds absolute URLs from forwarded headers, so pin them here.
      import trusted_edge_client_ip
      header_up Host {host}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Port 443
      transport http {
        dial_timeout 3s
        response_header_timeout 15s
      }
    }
  }
}
