#!/usr/bin/env bash
set -euo pipefail

# bash resolves regex ranges such as [a-z0-9] through locale collation, so under a
# single-byte locale like en_US.ISO8859-1 those ranges also match uppercase and the branch
# rules below stop blocking anything they were written to block. Pin LC_ALL (not only
# LC_COLLATE) because an exported LC_ALL would otherwise override the pin. Same reasoning as
# .githooks/commit-msg, which pins the locale for its Hangul range.
export LC_ALL=C

protected_branches_regex='^(main|develop)$'
work_branch_regex='^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)/[a-z0-9]+(-[a-z0-9]+)*$'
# Dependabot pushes through the GitHub API and never runs this hook, so its branch names
# were never negotiable here. A human adding a correction commit to such a PR does run the
# hook, and dependabot/<ecosystem>/<path>/<dependency>-<version> keeps the dots and slashes
# that the work branch rule forbids. Allow that one namespace with an explicit shape instead
# of loosening the work branch rule.
bot_branch_regex='^dependabot/[a-z0-9_]+(/[A-Za-z0-9][A-Za-z0-9._-]*)+$'
zero_sha='0000000000000000000000000000000000000000'

branch_name_from_ref() {
  local ref="${1:-}"
  if [[ "${ref}" =~ ^refs/heads/(.+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

violations=()

validate_branch() {
  local branch="${1:-}"

  if [[ "${branch}" =~ ${protected_branches_regex} ]]; then
    return 1
  fi

  if [[ "${branch}" =~ ${bot_branch_regex} ]]; then
    return 0
  fi

  if [[ "${branch}" =~ ${work_branch_regex} ]]; then
    return 0
  fi

  return 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue

  if local_branch="$(branch_name_from_ref "${local_ref}")"; then
    if ! validate_branch "${local_branch}"; then
      violations+=("local:${local_branch}")
    fi
  elif [[ "${local_sha}" != "${zero_sha}" ]]; then
    violations+=("local-ref:${local_ref}")
  fi

  if remote_branch="$(branch_name_from_ref "${remote_ref}")"; then
    if ! validate_branch "${remote_branch}"; then
      violations+=("remote:${remote_branch}")
    fi
  elif [[ "${remote_sha}" != "${zero_sha}" ]]; then
    violations+=("remote-ref:${remote_ref}")
  fi
done

if [[ "${#violations[@]}" -gt 0 ]]; then
  {
    echo "[pre-push] main/develop 직접 push 는 금지됩니다."
    echo "[pre-push] 허용 브랜치 형식: type/short-description"
    echo "[pre-push] 허용 type: feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix"
    echo "[pre-push] 허용 bot 브랜치: dependabot/<ecosystem>/<path>/<dependency>-<version>"
    echo "[pre-push] 차단된 ref:"
    for violation in "${violations[@]}"; do
      echo "  - ${violation}"
    done
    echo "[pre-push] 예시: feat/search-issue-workflow"
    echo "[pre-push] 권장 흐름: issue 생성 -> work branch 작업 -> develop 대상 PR"
  } >&2
  exit 1
fi

exit 0
