#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file is required}"

# Optional per-machine commit message filter (fail-closed on non-zero exit).
commit_msg_filter="$(git config --get hooks.commitMsgFilter || true)"
if [[ -n "${commit_msg_filter}" && -f "${commit_msg_filter}" && -x "${commit_msg_filter}" ]]; then
  if ! "${commit_msg_filter}" "$msg_file"; then
    echo "[commit-msg] hooks.commitMsgFilter 실행 실패로 커밋을 중단합니다: ${commit_msg_filter}" >&2
    exit 1
  fi
fi

export LC_ALL=C

comment_char="$(git config --get core.commentChar || true)"
if [[ -z "${comment_char}" || "${comment_char}" == "auto" ]]; then
  comment_char="#"
fi

subject=""
disallowed_trailer_re='^[[:space:]]*([^[:alnum:][:space:]]+[[:space:]]*)?(co[- ]authored[- ]by[[:space:]]*:|(generated|assisted)[- ]*(with|by)[[:space:]]*:|generated[[:space:]]+with([[:space:]:]|$)|authored[- ]by[[:space:]]*:)'
while IFS= read -r line || [[ -n "${line}" ]]; do
  line="${line//$'\r'/}"
  blank="${line//[[:space:]]/}"
  if [[ -z "${blank}" ]]; then
    continue
  fi
  if [[ "${line:0:1}" == "${comment_char}" ]]; then
    continue
  fi
  if [[ -z "${subject}" ]]; then
    subject="${line}"
  fi
  normalized_line="$(printf '%s' "${line}" | tr '[:upper:]' '[:lower:]')"
  if [[ "${normalized_line}" =~ ${disallowed_trailer_re} ]]; then
    echo "[commit-msg] 허용되지 않는 공동 작성 또는 자동 생성 트레일러가 포함되어 있습니다." >&2
    exit 1
  fi
done < "$msg_file"

autogenerated_re='^(Merge|Revert|fixup!|squash!|amend!) '
if [[ "$subject" =~ $autogenerated_re ]]; then
  exit 0
fi

bracket_re='^\[(Feat|Fix|Refactor|Chore|Docs|Style|Test|Perf|Build|CI|Revert|Hotfix|Security)\] [^[:space:]].*$'
conventional_re='^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]].*$'

if ! [[ "$subject" =~ $bracket_re || "$subject" =~ $conventional_re ]]; then
  cat >&2 <<'EOF'
[commit-msg] commit message format violation
Allowed formats:
  [Feat|Fix|Refactor|Chore|Docs|Style|Test|Perf|Build|CI|Revert|Hotfix|Security] <summary>
  <type>(<scope>): <summary>
Examples:
  [Chore] 1인 프로젝트 방식으로 전환
  feat(auth): stabilize session refresh
EOF
  exit 1
fi
