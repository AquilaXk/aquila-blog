{
  "version": 1,
  "placeholderPattern": "^(?:(?:NEED_TO|change_me|change-me).*$|EMPTY$|.*example\\.com$|.*<[^>]+>.*)$",
  "targets": {
    "production": {
      "keys": [
        { "name": "NEXT_PUBLIC_BACKEND_URL", "kind": "https-url" },
        { "name": "BACKEND_INTERNAL_URL", "kind": "https-url" },
        { "name": "NEXT_PUBLIC_SITE_URL", "kind": "https-url" },
        { "name": "TOKEN_FOR_REVALIDATE", "secret": true, "minLength": 12 },
        { "name": "BACKEND_PROXY_MAX_BODY_BYTES", "kind": "positive-decimal" },
        { "name": "BACKEND_PROXY_MAX_IN_FLIGHT_BODY_BYTES", "kind": "positive-decimal" },
        { "name": "NEXT_PUBLIC_SIGNUP_ENABLED", "allowedValues": ["false"] },
        { "name": "NEXT_PUBLIC_RUM_SAMPLE_RATE", "allowedValues": ["0"] }
      ]
    },
    "test": {
      "keys": [
        { "name": "NEXT_PUBLIC_SIGNUP_ENABLED", "allowedValues": ["false", "true"] },
        { "name": "NEXT_PUBLIC_RUM_SAMPLE_RATE", "allowedValues": ["0", "1"] }
      ]
    },
    "live-ready": {
      "keys": [
        { "name": "PLAYWRIGHT_BASE_URL", "kind": "https-url" },
        { "name": "E2E_API_BASE_URL", "kind": "https-url" }
      ]
    },
    "live-e2e": {
      "keys": [
        { "name": "PLAYWRIGHT_BASE_URL", "kind": "https-url" },
        { "name": "E2E_API_BASE_URL", "kind": "https-url" },
        { "name": "E2E_LIVE_ADMIN_EMAIL", "required": false },
        { "name": "E2E_LIVE_ADMIN_USERNAME", "required": false },
        { "name": "E2E_LIVE_ADMIN_PASSWORD", "secret": true }
      ],
      "crossChecks": [
        { "type": "exactlyOneOf", "keys": ["E2E_LIVE_ADMIN_EMAIL", "E2E_LIVE_ADMIN_USERNAME"] }
      ]
    }
  }
}
