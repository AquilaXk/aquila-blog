#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

staged_files="$(git diff --cached --name-only --diff-filter=ACMRD)"
if [[ -z "${staged_files}" ]]; then
  exit 0
fi

bash tools/guards/check-forbidden-tracked-files.sh --staged
bash tools/guards/check-current-task-state.sh
bash tools/guards/check-current-task-scope.sh --staged

needs_platform_contract_check="false"
needs_frontend_contract_check="false"
needs_detail_render_guard="false"
while IFS= read -r file; do
  case "${file}" in
    .githooks/pre-commit|back/src/main/*|back/src/main/resources/*|back/src/test/kotlin/com/back/global/springDoc/*|back/src/test/kotlin/com/back/global/contracts/*|contracts/public-api/**|tools/contracts/**)
      needs_platform_contract_check="true"
      ;;
    front/contracts/platform/**|front/packages/shared-contracts/src/generated/backend-openapi.d.ts|front/scripts/contracts/**|front/scripts/openapi/check-contract-drift.mjs)
      needs_frontend_contract_check="true"
      ;;
    .github/workflows/ci.yml|.github/workflows/reusable-backend-quality.yml)
      needs_platform_contract_check="true"
      ;;
    .github/workflows/reusable-frontend-verify.yml)
      needs_frontend_contract_check="true"
      ;;
    front/src/pages/posts/\[id\].tsx|front/src/routes/Detail/*|front/src/libs/markdown/*|front/src/libs/postSummary.ts|front/src/libs/server/postDetailPage.ts)
      needs_detail_render_guard="true"
      ;;
  esac
done <<< "${staged_files}"

if [[ "${needs_platform_contract_check}" != "true" && "${needs_frontend_contract_check}" != "true" && "${needs_detail_render_guard}" != "true" ]]; then
  exit 0
fi

if [[ "${needs_platform_contract_check}" == "true" ]]; then
  if [[ ! -x "back/gradlew" ]]; then
    echo "[pre-commit] back/gradlew 실행 파일을 찾지 못해 Platform 계약 검사를 실행할 수 없습니다." >&2
    exit 1
  fi

  echo "[pre-commit] Platform 계약 산출물 검사 실행"
  back/gradlew -p back test \
    --tests "com.back.global.springDoc.OpenApiContractExportTest" \
    --tests "com.back.global.contracts.ErrorCodeContractExportTest" \
    --no-daemon
  node tools/contracts/sync-public-contracts.mjs
  git ls-files --error-unmatch -- \
    contracts/public-api/openapi.json \
    contracts/public-api/error-codes.json \
    contracts/public-api/manifest.json >/dev/null
  git diff --exit-code -- contracts/public-api
fi

if [[ "${needs_frontend_contract_check}" == "true" || "${needs_detail_render_guard}" == "true" ]] && ! command -v yarn >/dev/null 2>&1; then
  echo "[pre-commit] yarn 명령을 찾지 못해 필요한 프런트엔드 검사를 실행할 수 없습니다." >&2
  exit 1
fi

if [[ "${needs_frontend_contract_check}" == "true" ]]; then
  echo "[pre-commit] OpenAPI 계약 드리프트 검사 실행: yarn contracts:check"
  (
    cd front
    yarn contracts:check
  )
fi

if [[ "${needs_detail_render_guard}" == "true" ]]; then
  echo "[pre-commit] 상세 렌더 회귀 가드 실행: yarn build"
  (
    cd front
    yarn build
  )

  echo "[pre-commit] 상세 렌더 회귀 가드 실행: node scripts/check-bundle-size.mjs"
  (
    cd front
    node scripts/check-bundle-size.mjs
  )

  echo "[pre-commit] 상세 렌더 회귀 가드 실행: yarn test:e2e:smoke"
  (
    cd front
    yarn test:e2e:smoke
  )
fi
