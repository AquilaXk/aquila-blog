# Back container env only (materialized to .env.back.prod from .env.prod).
# Allowlisted prefixes: PROD___SPRING__*, PROD___CUSTOM__*, CUSTOM__*, CUSTOM_*,
# SPRING__*, MANAGEMENT_*, BACKEND_PROXY_*.
# Explicitly excluded: PROD___POSTGRES__PASSWORD, PROD___POSTGRES_EXPORTER__*.
# Key names only — never commit real secret values.

PROD___SPRING__DATASOURCE__USERNAME=blog_app
PROD___SPRING__DATASOURCE__PASSWORD=change_me_db_runtime_password
# Dedicated Flyway role (required). Must not be postgres (#1131).
PROD___SPRING__FLYWAY__USER=blog_flyway
PROD___SPRING__FLYWAY__PASSWORD=change_me_flyway_password
PROD___SPRING__DATA__REDIS__PASSWORD=change_me_redis_password
CUSTOM__JWT__SECRET_KEY=change_me_very_long_secret_key_32_plus
PROD___CUSTOM__POST__READ__CURSOR_SIGNING_SECRET=change_me_cursor_signing_secret_32_plus
PROD___CUSTOM__POST__READ__CURSOR_SIGNING_KEY_VERSION=2
# Previous key/version/expiry are enabled only together for a maximum 24-hour rotation window.
# Before expiry, remove all three previous entries from authoritative HOME_SERVER_ENV.
# An expired previous key makes startup/precheck/doctor/rollback fail; it is never auto-ignored.
# PROD___CUSTOM__POST__READ__CURSOR_PREVIOUS_SIGNING_SECRET=change_me_previous_cursor_signing_secret_32_plus
# PROD___CUSTOM__POST__READ__CURSOR_PREVIOUS_SIGNING_KEY_VERSION=1
# PROD___CUSTOM__POST__READ__CURSOR_PREVIOUS_EXPIRES_AT_EPOCH_SECONDS=1700000000
CUSTOM__ADMIN__USERNAME=관리자
CUSTOM__ADMIN__EMAIL=admin@example.com
CUSTOM__ADMIN__PASSWORD=change_me_admin_password
CUSTOM__AUTH__ADMIN_EMAIL__CHALLENGE_EXPIRATION_SECONDS=600
CUSTOM__AUTH__ADMIN_EMAIL__MAX_FAILED_ATTEMPTS=5
CUSTOM__AUTH__ADMIN_EMAIL__REQUEST_MAX_PER_WINDOW=5
CUSTOM__AUTH__ADMIN_EMAIL__REQUEST_WINDOW_SECONDS=600
CUSTOM__AUTH__ADMIN_EMAIL__REQUEST_DEADLINE_MILLIS=5000
CUSTOM_PROD_COOKIEDOMAIN=example.com
CUSTOM_PROD_FRONTURL=https://www.example.com
CUSTOM_PROD_BACKURL=https://api.example.com
CUSTOM_PROD_DBNAME=blog_prod
CUSTOM_PROD_REDISDATABASE=0
CUSTOM__REVALIDATE__URL=https://www.example.com/api/revalidate
CUSTOM__REVALIDATE__TOKEN=change_me_revalidate_token
SPRING__MAIL__HOST=smtp.example.com
SPRING__MAIL__PORT=587
# Required sender address for administrator email verification.
SPRING__MAIL__USERNAME=mailer@example.com
SPRING__MAIL__PASSWORD=change_me_smtp_password
SPRING__MAIL__PROPERTIES__MAIL__SMTP__AUTH=true
SPRING__MAIL__PROPERTIES__MAIL__SMTP__STARTTLS__ENABLE=true
SPRING__MAIL__PROPERTIES__MAIL__SMTP__STARTTLS__REQUIRED=true
SPRING__MAIL__PROPERTIES__MAIL__SMTP__SSL__CHECKSERVERIDENTITY=true
SPRING__MAIL__PROPERTIES__MAIL__SMTP__CONNECTIONTIMEOUT=5000
SPRING__MAIL__PROPERTIES__MAIL__SMTP__TIMEOUT=10000
SPRING__MAIL__PROPERTIES__MAIL__SMTP__WRITETIMEOUT=10000
CUSTOM__MEMBER__SIGNUP__MAIL_FROM=mailer@example.com
CUSTOM_STORAGE_ENABLED=true
CUSTOM_STORAGE_ENDPOINT=http://minio:9000
CUSTOM_STORAGE_REGION=us-east-1
CUSTOM_STORAGE_BUCKET=blog-images
CUSTOM_STORAGE_ACCESSKEY=generated_storage_access_key
CUSTOM_STORAGE_SECRETKEY=change_me_generated_storage_secret
CUSTOM_STORAGE_CREDENTIAL_VERSION=1
CUSTOM_STORAGE_PATHSTYLEACCESS=true
CUSTOM_STORAGE_KEYPREFIX=posts
CUSTOM_STORAGE_CLOUD_KEY_PREFIX=cloud
