#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file is required}"

# Optional per-machine commit message filter (for example an editor/agent attribution
# stripper that lives outside this repository). Opt in locally so that no personal path is
# hardcoded here:
#   git config hooks.commitMsgFilter /path/to/filter.sh
# It runs before commit validation so the filter keeps the developer's own locale, and a
# failing filter only warns: the commit message rules stay the source of truth.
commit_msg_filter="$(git config --get hooks.commitMsgFilter || true)"
if [[ -n "${commit_msg_filter}" && -f "${commit_msg_filter}" && -x "${commit_msg_filter}" ]]; then
  if ! "${commit_msg_filter}" "$msg_file"; then
    echo "[commit-msg] hooks.commitMsgFilter 실행 실패, 무시하고 계속합니다: ${commit_msg_filter}" >&2
  fi
fi

# Git drops blank leading lines and comment lines from the commit message, so the subject is
# the first line that is neither.
comment_char="$(git config --get core.commentChar || true)"
if [[ -z "${comment_char}" || "${comment_char}" == "auto" ]]; then
  comment_char="#"
fi

subject=""
while IFS= read -r line || [[ -n "${line}" ]]; do
  line="${line//$'\r'/}"
  blank="${line//[[:space:]]/}"
  if [[ -z "${blank}" ]]; then
    continue
  fi
  if [[ "${line:0:1}" == "${comment_char}" ]]; then
    continue
  fi
  subject="${line}"
  break
done < "$msg_file"

# Allow Git auto-generated/system commit titles.
autogenerated_re='^(Merge|Revert|fixup!|squash!|amend!) '
if [[ "$subject" =~ $autogenerated_re ]]; then
  exit 0
fi

# Keep ASCII-only validation independent of the caller's locale. This runs after the
# optional filter so that local filters retain the developer's locale.
export LC_ALL=C

# Required format: Conventional Commit with a non-empty summary.
# - <type>(<scope>): <summary>
# - The summary uses printable ASCII and includes an English letter.
#
# Example:
#   feat(auth): stabilize session refresh
#   fix(feed): prevent duplicate optimistic updates
if ! [[ "$subject" =~ ^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)(\([a-z0-9][a-z0-9._/-]*\))?!?:\ .+$ ]]; then
  cat >&2 <<'EOF'
[commit-msg] 커밋 메시지 규칙 위반
형식: <type>(<scope>): <요약>
예시1: feat(auth): stabilize session refresh
예시2: fix(feed): 좋아요 optimistic update 수정
허용 타입: feat, fix, refactor, chore, docs, style, test, perf, build, ci, revert, hotfix
EOF
  exit 1
fi

summary="${subject#*: }"
ascii_printable_re='^[ -~]+$'
if ! [[ "${summary}" =~ ${ascii_printable_re} && "${summary}" =~ [A-Za-z] ]]; then
  echo "[commit-msg] summary must use printable ASCII and include an English letter" >&2
  exit 1
fi
