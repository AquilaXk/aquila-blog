{
  "version": 1,
  "placeholderPattern": "^(?:NEED_TO|EMPTY$|change_me|change-me|.*example\\\\.com$|https://www\\\\.example\\\\.com|https://api\\\\.example\\\\.com|smtp\\\\.example\\\\.com|.*<[^>]+>.*|.*sha-<[^>]+>.*)",
  "targets": {
    "home-server-source": {
      "description": "GitHub Secret HOME_SERVER_ENV before deploy-time image injection.",
      "keys": [
        {
          "name": "API_DOMAIN",
          "kind": "hostname",
          "description": "Single switch for the prod site trio (see the cookieDomainScope crossCheck). Constrained here so an undeclared value fails on the runner, before the remote script has touched .env.prod.",
          "allowedValues": ["api.blog.aquilaxk.site", "api.aquilaxk.site"]
        },
        {
          "name": "LEGACY_API_DOMAIN",
          "kind": "hostname",
          "required": false,
          "description": "Transition-only second site address for the API vhost, so the old and the new public API host are both reachable during the domain cutover. Unset outside that window. Deliberately NOT part of cookieDomainScope.topologies: it is the host the transition is moving away from, so the topology invariants do not apply to it.",
          "warnWhenPresent": "the domain cutover window is open: the old public API host is still served. Remove LEGACY_API_DOMAIN (and its DNS/Tunnel hostname) once the new host is verified (#1540).",
          "rejectEmptyValue": true,
          "forbiddenValues": ["aquilaxk.site", "www.aquilaxk.site"]
        },
        {
          "name": "WEB_DOMAIN",
          "kind": "hostname",
          "required": false,
          "requiredWhen": { "key": "API_DOMAIN", "equals": "api.blog.aquilaxk.site" },
          "mustDifferFrom": "API_DOMAIN",
          "description": "Public web host served by the Caddy front vhost (#1538). Optional only before the cutover: once API_DOMAIN moves to the blog topology, leaving this unset would 404 the public site while the contract still passed. Colliding with API_DOMAIN would duplicate a Caddy site address and take the whole edge down on the next caddy recreate."
        },
        {
          "name": "WEB_UPSTREAM",
          "required": false,
          "allowedValues": ["front_blue", "front_green"],
          "description": "Active front colour the Caddy web vhost proxies to (default front_blue). Interpolated straight into the Caddyfile reverse_proxy target, so a typo would route public web traffic at whatever else Caddy can reach. The blue/green switch that writes it is #1539."
        },
        { "name": "MONITOR_DOMAIN", "kind": "hostname" },
        { "name": "GRAFANA_DOMAIN", "kind": "hostname" },
        { "name": "PROMETHEUS_DOMAIN", "kind": "hostname" },
        { "name": "ADMIN_EMBED_ORIGINS" },
        { "name": "CADDY_EMAIL", "kind": "email" },
        { "name": "CF_TUNNEL_TOKEN", "secret": true, "minLength": 12 },
        { "name": "CLOUDFLARED_IMAGE", "kind": "digest-image" },
        { "name": "AUTOHEAL_IMAGE", "kind": "digest-image", "required": false },
        { "name": "DOCKER_SOCKET_PROXY_IMAGE", "kind": "digest-image", "required": false },
        { "name": "CADDY_IMAGE", "kind": "digest-image", "required": false },
        { "name": "UPTIME_KUMA_IMAGE", "kind": "digest-image", "required": false },
        { "name": "PROMETHEUS_IMAGE", "kind": "digest-image", "required": false },
        { "name": "ALERTMANAGER_IMAGE", "kind": "digest-image", "required": false },
        { "name": "POSTGRES_EXPORTER_IMAGE", "kind": "digest-image", "required": false },
        { "name": "GRAFANA_IMAGE", "kind": "digest-image", "required": false },
        { "name": "LOKI_IMAGE", "kind": "digest-image", "required": false },
        { "name": "PROMTAIL_IMAGE", "kind": "digest-image", "required": false },
        { "name": "NODE_RUNTIME_IMAGE", "kind": "digest-image", "required": false },
        { "name": "DB_IMAGE", "kind": "digest-image" },
        { "name": "REDIS_IMAGE", "kind": "digest-image", "required": false },
        { "name": "MINIO_IMAGE", "kind": "digest-image" },
        { "name": "AQUILA_EXTERNAL_STORAGE_ROOT", "kind": "safe-absolute-path", "required": false, "allowedValues": ["/mnt/aquila-blog-data"] },
        { "name": "AQUILA_BACKUP_ROOT", "kind": "safe-absolute-path", "required": false },
        { "name": "AQUILA_BACKUP_RETENTION_DAILY", "kind": "integer", "required": false, "min": 1 },
        { "name": "AQUILA_BACKUP_RETENTION_WEEKLY", "kind": "integer", "required": false, "min": 1 },
        { "name": "AQUILA_BACKUP_RETENTION_MONTHLY", "kind": "integer", "required": false, "min": 1 },
        { "name": "AQUILA_BACKUP_MIN_FREE_PERCENT", "kind": "integer", "required": false, "min": 0, "max": 99 },
        { "name": "AQUILA_BACKUP_ENCRYPTION_KEY_FILE", "kind": "safe-absolute-path", "required": false },
        { "name": "AQUILA_RESTORE_PRIVACY_GATE_SCRIPT", "kind": "safe-absolute-path" },
        { "name": "AUTOHEAL_INTERVAL_SECONDS", "kind": "integer", "required": false },
        { "name": "AUTOHEAL_START_PERIOD_SECONDS", "kind": "integer", "required": false },
        { "name": "BACK_MEM_LIMIT", "required": false },
        { "name": "BACK_MEM_RESERVATION", "required": false },
        { "name": "BACK_READ_MEM_LIMIT", "required": false },
        { "name": "BACK_READ_MEM_RESERVATION", "required": false },
        { "name": "BACK_ADMIN_MEM_LIMIT", "required": false },
        { "name": "BACK_ADMIN_MEM_RESERVATION", "required": false },
        { "name": "BACK_WORKER_MEM_LIMIT", "required": false },
        { "name": "BACK_WORKER_MEM_RESERVATION", "required": false },
        { "name": "BACK_AUTOHEAL_ENABLED", "kind": "boolean", "required": false },
        {
          "name": "BACKEND_INTERNAL_URL",
          "kind": "url",
          "required": false,
          "requiredWhen": { "key": "API_DOMAIN", "equals": "api.blog.aquilaxk.site" },
          "description": "Compose-internal backend base URL the front SSR path uses (e.g. http://back-blue:8080). front/src/libs/server/backend.ts throws in production when it is missing, and the front container still reports healthy because the healthcheck only serves a static file. Public internet must not be traversed here."
        },
        { "name": "FRONT_MEM_LIMIT", "required": false },
        { "name": "FRONT_MEM_RESERVATION", "required": false },
        { "name": "FRONT_AUTOHEAL_ENABLED", "kind": "boolean", "required": false },
        { "name": "CUSTOM__RUNTIME__API_MODE", "required": false },
        { "name": "CUSTOM__RUNTIME__API_MODE_BLUE", "required": false },
        { "name": "CUSTOM__RUNTIME__API_MODE_GREEN", "required": false },
        { "name": "CUSTOM__RUNTIME__API_MODE_WORKER", "required": false },
        { "name": "PROMETHEUS_BASIC_AUTH_USER", "forbiddenValues": ["promviewer"] },
        {
          "name": "PROMETHEUS_BASIC_AUTH_HASH",
          "secret": true,
          "minLength": 50,
          "forbiddenSha256": [
            "6e9101876c919171629f4cc9a6af6c7f8ee7f3438558f9b6ca6f6c180cb4abf7",
            "41f14820b4b0e106cc7f0d0823a29de0445ba4504a8607d5ca3a67ceddd0181c"
          ]
        },
        { "name": "OPERATIONS_ALERT_EMAIL_TO", "kind": "email", "secret": true },
        { "name": "ALERTMANAGER_SMTP_AUTH_ENABLED", "kind": "boolean", "required": false },
        {
          "name": "ALERTMANAGER_SMTP_AUTH_USERNAME",
          "requiredWhen": { "key": "ALERTMANAGER_SMTP_AUTH_ENABLED", "equals": "true" }
        },
        {
          "name": "ALERTMANAGER_SMTP_AUTH_PASSWORD",
          "secret": true,
          "requiredWhen": { "key": "ALERTMANAGER_SMTP_AUTH_ENABLED", "equals": "true" },
          "minLength": 8
        },
        { "name": "PROMETHEUS_RETENTION_TIME", "required": false },
        { "name": "PUBLIC_EDGE_PROBE_REFRESH_MS", "kind": "integer", "required": false },
        { "name": "PUBLIC_EDGE_PROBE_REQUESTS", "kind": "integer", "required": false },
        { "name": "PUBLIC_EDGE_PROBE_LATEST_POSTS", "kind": "integer", "required": false },
        { "name": "PUBLIC_EDGE_PROBE_TIMEOUT_MS", "kind": "integer", "required": false },
        { "name": "PUBLIC_EDGE_PROBE_BASE_URL", "kind": "https-url", "required": false },
        { "name": "GRAFANA_ADMIN_USER" },
        {
          "name": "GRAFANA_ADMIN_PASSWORD",
          "secret": true,
          "minLength": 16,
          "forbiddenValues": ["change_me_grafana_password"],
          "mustDifferFrom": "GRAFANA_ADMIN_USER"
        },
        { "name": "GRAFANA_ROOT_URL", "kind": "https-url" },
        { "name": "PROD___SPRING__DATASOURCE__USERNAME" },
        {
          "name": "PROD___SPRING__FLYWAY__USER",
          "required": true,
          "forbiddenValues": ["postgres"],
          "description": "Dedicated Flyway migration role. Must not be postgres superuser (#1131)."
        },
        {
          "name": "PROD___SPRING__FLYWAY__PASSWORD",
          "required": true,
          "secret": true,
          "minLength": 8,
          "description": "Required dedicated Flyway password. No PROD___POSTGRES__PASSWORD fallback (#1131)."
        },
        { "name": "PROD___SPRING__DATASOURCE__PASSWORD", "secret": true, "minLength": 8 },
        { "name": "PROD___POSTGRES__PASSWORD", "secret": true, "minLength": 8 },
        {
          "name": "PROD___POSTGRES_EXPORTER__USERNAME",
          "required": false,
          "description": "Dedicated postgres_exporter role (default postgres_exporter). Must not be postgres."
        },
        {
          "name": "PROD___POSTGRES_EXPORTER__PASSWORD",
          "secret": true,
          "minLength": 8,
          "description": "Password for pg_monitor exporter role. Never reuse the postgres superuser password in docs."
        },
        { "name": "PROD___SPRING__DATA__REDIS__PASSWORD", "secret": true, "minLength": 8 },
        { "name": "CUSTOM__JWT__SECRET_KEY", "secret": true, "minLength": 32 },
        { "name": "CUSTOM__ADMIN__USERNAME" },
        { "name": "CUSTOM__ADMIN__EMAIL", "kind": "email" },
        { "name": "CUSTOM__ADMIN__PASSWORD", "secret": true, "minLength": 8 },
        { "name": "CUSTOM_PROD_COOKIEDOMAIN", "kind": "hostname" },
        { "name": "CUSTOM_PROD_FRONTURL", "kind": "https-url" },
        { "name": "CUSTOM_PROD_BACKURL", "kind": "https-url" },
        { "name": "CUSTOM_PROD_DBNAME" },
        { "name": "DB_BASE_NAME", "required": false },
        { "name": "CUSTOM_PROD_REDISDATABASE", "kind": "integer" },
        {
          "name": "CUSTOM__REVALIDATE__URL",
          "kind": "https-url",
          "required": false,
          "warnWhenAbsent": "post write/modify/delete events enqueue revalidate tasks (RevalidateEventListener) that RevalidateService drops silently while this is empty, so published posts only appear after the 1h ISR window. Set it once the front tier runs on the homeserver (#1538)."
        },
        {
          "name": "CUSTOM__REVALIDATE__TOKEN",
          "secret": true,
          "required": false,
          "minLength": 12,
          "warnWhenAbsent": "RevalidateService also drops every task when this is empty, even if CUSTOM__REVALIDATE__URL is set."
        },
        { "name": "CUSTOM__AI__SUMMARY__ENABLED", "kind": "boolean", "required": false, "allowedValues": ["false"] },
        {
          "name": "CUSTOM__AI__SUMMARY__GEMINI__API_KEY",
          "secret": true,
          "requiredWhen": { "key": "CUSTOM__AI__SUMMARY__ENABLED", "equals": "true" },
          "minLength": 8
        },
        { "name": "CUSTOM__AI__SUMMARY__GEMINI__MODEL", "required": false },
        { "name": "SPRING__MAIL__HOST" },
        { "name": "SPRING__MAIL__PORT", "kind": "integer" },
        { "name": "SPRING__MAIL__USERNAME", "required": false },
        { "name": "SPRING__MAIL__PASSWORD", "secret": true, "required": false, "minLength": 8 },
        { "name": "SPRING__MAIL__PROPERTIES__MAIL__SMTP__AUTH", "kind": "boolean", "required": false },
        { "name": "SPRING__MAIL__PROPERTIES__MAIL__SMTP__STARTTLS__ENABLE", "kind": "boolean", "required": false },
        { "name": "CUSTOM__MEMBER__SIGNUP__MAIL_FROM", "kind": "email" },
        { "name": "CUSTOM__MEMBER__SIGNUP__MAIL_SUBJECT", "required": false },
        { "name": "CUSTOM__MEMBER__SIGNUP__VERIFY_PATH", "required": false },
        { "name": "CUSTOM__MEMBER__SIGNUP__EMAIL_EXPIRATION_SECONDS", "kind": "integer", "required": false },
        { "name": "CUSTOM__MEMBER__SIGNUP__SESSION_EXPIRATION_SECONDS", "kind": "integer", "required": false },
        { "name": "CUSTOM__MEMBER__SIGNUP__ENABLED", "kind": "boolean", "required": false, "allowedValues": ["false"] },
        { "name": "CUSTOM__MEMBER__OAUTH_SIGNUP__ENABLED", "kind": "boolean", "required": false, "allowedValues": ["false"] },
        { "name": "MINIO_ROOT_USER" },
        { "name": "MINIO_ROOT_PASSWORD", "secret": true, "minLength": 8 },
        { "name": "MINIO_API_STALE_UPLOADS_EXPIRY", "required": false, "allowedValues": ["8d"] },
        { "name": "MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL", "required": false, "allowedValues": ["6h"] },
        { "name": "CUSTOM_STORAGE_ENABLED", "kind": "boolean" },
        { "name": "CUSTOM_STORAGE_ENDPOINT", "kind": "url", "requiredWhen": { "key": "CUSTOM_STORAGE_ENABLED", "equals": "true" } },
        { "name": "CUSTOM_STORAGE_REGION", "required": false },
        { "name": "CUSTOM_STORAGE_BUCKET", "requiredWhen": { "key": "CUSTOM_STORAGE_ENABLED", "equals": "true" } },
        { "name": "CUSTOM_STORAGE_ACCESSKEY", "secret": true, "requiredWhen": { "key": "CUSTOM_STORAGE_ENABLED", "equals": "true" } },
        { "name": "CUSTOM_STORAGE_SECRETKEY", "secret": true, "requiredWhen": { "key": "CUSTOM_STORAGE_ENABLED", "equals": "true" }, "minLength": 8 },
        { "name": "CUSTOM_STORAGE_PATHSTYLEACCESS", "kind": "boolean", "required": false },
        {
          "name": "CUSTOM_STORAGE_KEYPREFIX",
          "required": false,
          "minLength": 1,
          "mustDifferFrom": "CUSTOM_STORAGE_CLOUD_KEY_PREFIX",
          "description": "Post object-key prefix (default posts). Must be non-blank when set; mutually exclusive with CUSTOM_STORAGE_CLOUD_KEY_PREFIX (no equality or path containment such as posts vs posts/images). Backend fails fast on blank/overlap."
        },
        {
          "name": "CUSTOM_STORAGE_CLOUD_KEY_PREFIX",
          "required": false,
          "minLength": 1,
          "mustDifferFrom": "CUSTOM_STORAGE_KEYPREFIX",
          "description": "Cloud object-key prefix (default cloud). Must be non-blank when set; mutually exclusive with CUSTOM_STORAGE_KEYPREFIX (no equality or path containment). Backend fails fast on blank/overlap."
        },
        { "name": "CUSTOM_STORAGE_MAXFILESIZEBYTES", "kind": "integer", "required": false, "min": 1 },
        { "name": "CUSTOM_STORAGE_CLOUD_DOCUMENT_MAXFILESIZEBYTES", "kind": "integer", "required": false, "min": 1 },
        { "name": "CUSTOM_STORAGE_CLOUD_PHOTO_MAXFILESIZEBYTES", "kind": "integer", "required": false, "min": 1 },
        { "name": "CUSTOM_STORAGE_CLOUD_ARCHIVE_MAXFILESIZEBYTES", "kind": "integer", "required": false, "min": 1 },
        { "name": "CUSTOM_STORAGE_CLOUD_VIDEO_MAXFILESIZEBYTES", "kind": "integer", "required": false, "min": 1 },
        { "name": "CUSTOM_STORAGE_CLOUD_VIDEO_RESUMABLE_MAXFILESIZEBYTES", "kind": "integer", "required": false, "min": 1 },
        { "name": "CUSTOM_STORAGE_CLOUD_VIDEO_RESUMABLE_PARTSIZEBYTES", "kind": "integer", "required": false, "min": 5242880 },
        { "name": "CUSTOM_STORAGE_CLOUD_VIDEO_RESUMABLE_EXPIRESSECONDS", "kind": "integer", "required": false, "min": 60 },
        {
          "name": "CUSTOM_STORAGE_CLOUD_VIDEO_RESUMABLE_ABSOLUTEMAXSECONDS",
          "kind": "integer",
          "required": false,
          "min": 60,
          "max": 604800
        },
        { "name": "CUSTOM_STORAGE_MULTIPART_MAX_FILE_SIZE", "required": false },
        { "name": "CUSTOM_STORAGE_MULTIPART_MAX_REQUEST_SIZE", "required": false }
      ],
      "crossChecks": [
        { "type": "urlHostEquals", "urlKey": "CUSTOM_PROD_BACKURL", "hostKey": "API_DOMAIN" },
        { "type": "urlHostEquals", "urlKey": "CUSTOM_PROD_FRONTURL", "hostKey": "WEB_DOMAIN" },
        {
          "description": "The auth cookie Domain is the front/back shared suffix, so every front-derived value must move together. API_DOMAIN is the single switch: it selects one declared topology, and the other values are compared against that topology by host (not by raw spelling, because HOME_SERVER_ENV values can differ in trailing slash or case). deploy.yml pins the same table. The table itself is checked against the invariants below, so a wrong table entry cannot pass by simply matching.",
          "type": "cookieDomainScope",
          "apiHostKey": "API_DOMAIN",
          "domainKey": "CUSTOM_PROD_COOKIEDOMAIN",
          "frontUrlKey": "CUSTOM_PROD_FRONTURL",
          "backUrlKey": "CUSTOM_PROD_BACKURL",
          "publicEdgeProbeUrlKey": "PUBLIC_EDGE_PROBE_BASE_URL",
          "revalidateUrlKey": "CUSTOM__REVALIDATE__URL",
          "adminEmbedOriginsKey": "ADMIN_EMBED_ORIGINS",
          "invariants": {
            "description": "Enforced against EVERY declared topology, not just the selected one, so a wrong table entry cannot hide until the switch flips. cookieDomain must be the web host itself and the public API must sit strictly under it; otherwise the front/back shared suffix climbs one level and session cookies reach hosts this blog does not own. forbiddenCookieDomains names the hosts another service owns. legacyUnsafeTopology is the single entry allowed to violate these, and it must carry structurallyUnsafe: true.",
            "forbiddenCookieDomains": ["aquilaxk.site", "www.aquilaxk.site"],
            "legacyUnsafeTopology": "api.aquilaxk.site"
          },
          "topologies": {
            "api.blog.aquilaxk.site": {
              "cookieDomain": "blog.aquilaxk.site",
              "frontHost": "blog.aquilaxk.site",
              "webHost": "blog.aquilaxk.site",
              "backHost": "api.blog.aquilaxk.site",
              "publicEdgeProbeBaseUrl": "https://blog.aquilaxk.site",
              "adminEmbedOrigins": "https://blog.aquilaxk.site",
              "revalidateUrl": "https://blog.aquilaxk.site/api/revalidate"
            },
            "api.aquilaxk.site": {
              "cookieDomain": "aquilaxk.site",
              "frontHost": "www.aquilaxk.site",
              "webHost": "www.aquilaxk.site",
              "backHost": "api.aquilaxk.site",
              "publicEdgeProbeBaseUrl": "https://www.aquilaxk.site",
              "adminEmbedOrigins": "https://www.aquilaxk.site",
              "revalidateUrl": "https://www.aquilaxk.site/api/revalidate",
              "structurallyUnsafe": true,
              "warn": "pre-transition domain set: the cookie Domain is the apex, which another service owns. Update HOME_SERVER_ENV API_DOMAIN to api.blog.aquilaxk.site to activate the blog domain contract (#1540)"
            }
          }
        },
        {
          "type": "pathWithin",
          "parentKey": "AQUILA_EXTERNAL_STORAGE_ROOT",
          "childKey": "AQUILA_BACKUP_ROOT",
          "defaultParent": "/mnt/aquila-blog-data",
          "strict": true
        },
        {
          "type": "pathNotWithin",
          "parentKey": "AQUILA_EXTERNAL_STORAGE_ROOT",
          "childKey": "AQUILA_BACKUP_ROOT",
          "relativeParent": "minio",
          "defaultParent": "/mnt/aquila-blog-data"
        },
        {
          "type": "pathNotWithin",
          "parentKey": "AQUILA_BACKUP_ROOT",
          "childKey": "AQUILA_BACKUP_ENCRYPTION_KEY_FILE",
          "defaultParent": "/mnt/aquila-blog-data/backups"
        },
        {
          "type": "pathNotWithin",
          "parentKey": "AQUILA_BACKUP_ROOT",
          "childKey": "AQUILA_RESTORE_PRIVACY_GATE_SCRIPT",
          "defaultParent": "/mnt/aquila-blog-data/backups"
        }
      ]
    },
    "home-server-runtime": {
      "extends": "home-server-source",
      "description": "Rendered deploy/homeserver/.env.prod after deploy-time runtime-specific backend image injection.",
      "keys": [
        { "name": "BACK_BLUE_IMAGE", "kind": "digest-image" },
        { "name": "BACK_GREEN_IMAGE", "kind": "digest-image" },
        { "name": "BACK_READ_IMAGE", "kind": "digest-image" },
        { "name": "BACK_ADMIN_IMAGE", "kind": "digest-image" },
        { "name": "BACK_WORKER_IMAGE", "kind": "digest-image" },
        {
          "name": "FRONT_BLUE_IMAGE",
          "kind": "digest-image",
          "required": false,
          "description": "Front runtime image for the blue colour (#1538). Digest only; ghcr.io/<owner>/<repo>-front tags are rejected. Optional until #1539 injects it, and the compose front profile stays off while it is empty."
        },
        {
          "name": "FRONT_GREEN_IMAGE",
          "kind": "digest-image",
          "required": false,
          "description": "Front runtime image for the green colour (#1538). Same digest-only rule as FRONT_BLUE_IMAGE."
        }
      ]
    },
    "back-local": {
      "description": "Ignored local backend env generated for devInfra.",
      "render": [
        { "name": "SPRING_PROFILES_ACTIVE", "fallback": "dev" },
        { "name": "DB_BASE_NAME", "fallback": "blog" },
        { "name": "DEV_DB_PASSWORD", "preserve": true, "fallback": "dev_db_password_change_me" },
        { "name": "DEV_REDIS_PASSWORD", "preserve": true, "fallback": "dev_redis_password_change_me" },
        { "name": "DEV_MINIO_ROOT_PASSWORD", "preserve": true, "fallback": "dev_minio_password_change_me" },
        { "name": "SPRING__DATASOURCE__PASSWORD", "from": ["DEV_DB_PASSWORD"], "fallback": "dev_db_password_change_me" },
        { "name": "SPRING__DATA__REDIS__PASSWORD", "from": ["DEV_REDIS_PASSWORD"], "fallback": "dev_redis_password_change_me" },
        { "name": "CUSTOM_PROD_COOKIEDOMAIN", "from": ["CUSTOM_PROD_COOKIEDOMAIN"], "fallback": "blog.aquilaxk.site" },
        { "name": "CUSTOM_PROD_FRONTURL", "from": ["CUSTOM_PROD_FRONTURL"], "fallback": "https://blog.aquilaxk.site" },
        { "name": "CUSTOM_PROD_BACKURL", "from": ["CUSTOM_PROD_BACKURL"], "fallback": "https://api.blog.aquilaxk.site" },
        { "name": "CUSTOM__JWT__SECRET_KEY", "from": ["CUSTOM__JWT__SECRET_KEY"], "preserve": true, "generate": "hex:48" },
        { "name": "CUSTOM__SYSTEM_MEMBER_API_KEY", "preserve": true, "generate": "hex:32" },
        { "name": "CUSTOM__ADMIN__USERNAME", "from": ["CUSTOM__ADMIN__USERNAME"], "fallback": "관리자" },
        { "name": "CUSTOM__ADMIN__EMAIL", "from": ["CUSTOM__ADMIN__EMAIL"], "fallback": "" },
        { "name": "CUSTOM__ADMIN__PASSWORD", "from": ["CUSTOM__ADMIN__PASSWORD"], "preserve": true, "fallback": "" },
        { "name": "CUSTOM__REVALIDATE__URL", "fallback": "http://localhost:3000/api/revalidate" },
        { "name": "CUSTOM__REVALIDATE__TOKEN", "from": ["CUSTOM__REVALIDATE__TOKEN"], "preserve": true, "generate": "hex:32" },
        { "name": "CUSTOM__AI__SUMMARY__ENABLED", "from": ["CUSTOM__AI__SUMMARY__ENABLED"], "fallback": "false" },
        { "name": "CUSTOM__AI__SUMMARY__GEMINI__API_KEY", "from": ["CUSTOM__AI__SUMMARY__GEMINI__API_KEY"], "fallback": "" },
