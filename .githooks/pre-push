#!/usr/bin/env bash
set -euo pipefail

# bash resolves regex ranges such as [a-z0-9] through locale collation, so under a
# single-byte locale like en_US.ISO8859-1 those ranges also match uppercase and the branch
# rules below stop blocking anything they were written to block. Pin LC_ALL (not only
# LC_COLLATE) because an exported LC_ALL would otherwise override the pin.
export LC_ALL=C

main_branch_regex='^main$'
work_branch_regex='^(feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix)/[a-z0-9]+(-[a-z0-9]+)*$'
bot_branch_regex='^dependabot/[a-z0-9_]+(/[A-Za-z0-9][A-Za-z0-9._-]*)+$'
zero_sha='0000000000000000000000000000000000000000'

branch_name_from_ref() {
  local ref="${1:-}"
  if [[ "${ref}" =~ ^refs/heads/(.+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

violations=()

validate_branch() {
  local branch="${1:-}"

  if [[ "${branch}" =~ ${main_branch_regex} ]]; then
    return 0
  fi

  if [[ "${branch}" =~ ${bot_branch_regex} ]]; then
    return 0
  fi

  if [[ "${branch}" =~ ${work_branch_regex} ]]; then
    return 0
  fi

  return 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue

  if local_branch="$(branch_name_from_ref "${local_ref}")"; then
    if ! validate_branch "${local_branch}"; then
      violations+=("local:${local_branch}")
    fi
  elif [[ "${local_ref}" == "HEAD" && "${remote_ref}" == "refs/heads/main" ]]; then
    :
  elif [[ "${local_sha}" != "${zero_sha}" ]]; then
    violations+=("local-ref:${local_ref}")
  fi

  if remote_branch="$(branch_name_from_ref "${remote_ref}")"; then
    if [[ "${local_sha}" == "${zero_sha}" && "${remote_branch}" =~ ${main_branch_regex} ]]; then
      violations+=("delete:${remote_branch}")
    elif ! validate_branch "${remote_branch}"; then
      violations+=("remote:${remote_branch}")
    fi
  elif [[ "${remote_sha}" != "${zero_sha}" ]]; then
    violations+=("remote-ref:${remote_ref}")
  fi
done

if [[ "${#violations[@]}" -gt 0 ]]; then
  {
    echo "[pre-push] 허용되지 않은 브랜치/ref push 또는 main 삭제가 감지되었습니다."
    echo "[pre-push] 허용 브랜치 형식: main 또는 type/short-description"
    echo "[pre-push] 허용 type: feat|fix|refactor|chore|docs|style|test|perf|build|ci|revert|hotfix"
    echo "[pre-push] 허용 bot 브랜치: dependabot/<ecosystem>/<path>/<dependency>-<version>"
    echo "[pre-push] 차단된 ref:"
    for violation in "${violations[@]}"; do
      echo "  - ${violation}"
    done
  } >&2
  exit 1
fi

exit 0
